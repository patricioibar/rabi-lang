#        i = i + 1
#        return i
#    return count

print "--- VARIABLE SHADOWING ---"
let a = 1
assert(a, 1)

if true:
    let a = 2
    assert(a, 2)

assert(a, 1)

if true:
    let a = 3
    assert(a, 3)
