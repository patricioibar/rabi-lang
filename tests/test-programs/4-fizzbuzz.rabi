func assert(input, expected):
    if (input != expected):
        print "ERROR"
    else:
        print "OK"


func fizzbuzz(n):
    let res = ""
    let i = 1
    while i <= n:
        if (i % 3 == 0 and i % 5 == 0):
            res = res + "FizzBuzz"
        else if (i % 3 == 0):
            res = res + "Fizz"
        else if (i % 5 == 0):
            res = res + "Buzz"
        i = i + 1

    return res


print "--- FIZZ BUZZ ---"
assert(fizzbuzz(2), "")
assert(fizzbuzz(3), "Fizz")
assert(fizzbuzz(5), "FizzBuzz")
assert(fizzbuzz(6), "FizzBuzzFizz")
assert(fizzbuzz(15), "FizzBuzzFizzFizzBuzzFizzFizzBuzz")
