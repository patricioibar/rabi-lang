func assert(input, expected):
    if (input != expected):
        print "ERROR"
    else:
        print "OK"
        
print "--- FOR LOOPS ---"
let total = 0
for n in [1, 2, 3, 4]:
    total = total + n
assert(total, 10)


func collect(arr):
    let out = []
    for item in arr:
        out = out + [item]
    return out

assert(collect([1, "dos", [3]]), [1, "dos", [3]])
assert(collect([]), [])

let seen = []
for n in [1, 2, 3, 4, 5]:
    if n == 2:
        continue
    if n == 5:
        break
    seen = seen + [n]
assert(seen, [1, 3, 4])

let item = "afuera"
for item in [1, 2]:
    assert(item != "afuera", true)
assert(item, "afuera")

let mutable = [1, 2, 3]
for n in mutable:
    mutable[0] = n * 10
assert(mutable, [30, 2, 3])


for n in [9]: assert(n, 9)
for n in [1] * 3: assert(n, 1)